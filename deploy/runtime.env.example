# File: deploy/runtime.env.example
# Purpose: Document required supplied-VM configuration without credentials.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Copy to /etc/autodocs/runtime.env on the VM. No credentials belong in Git.
RELEASE_ID=REPLACE_WITH_REVIEWED_GIT_SHA
SITE_ADDRESS=docs.example.com
HTTP_ONLY=false
ACME_EMAIL=you@example.com
STATE_DIR=/srv/autodocs
DB_PASSWORD_FILE=/etc/autodocs/secrets/db_password
WEB_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
