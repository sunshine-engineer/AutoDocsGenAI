

GROQ_API_KEY=
LANGSMITH_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# Local PostgreSQL/pgvector development settings. Change the password in .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=autodocs
POSTGRES_USER=autodocs
POSTGRES_PASSWORD=autodocs-local-change-me
DATABASE_URL=postgresql+psycopg://autodocs:autodocs-local-change-me@postgres:5432/autodocs
FASTEMBED_CACHE_PATH=/models/fastembed
# Safe default: inspect migration state but do not apply pending revisions.
# Set to true only when intentionally migrating the development database.
AUTO_APPLY_MIGRATIONS=false