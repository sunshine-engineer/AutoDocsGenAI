# File: .env.example
# Purpose: Exported development options; copy locally and replace demo credentials.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Python does not load this file implicitly. Use uv run --env-file .env ... or export.
# Compose automatically reads its project .env. See docs/configuration.md.

# Application YAML and shared HTTP transport (existing defaults).
AUTODOCS_CONFIG_FILE=config/config.yaml
AUTODOCS_HTTP_TIMEOUT_SECONDS=30
AUTODOCS_HTTP_USER_AGENT='AutoDocPipeline/0.1 (Documentation Knowledge Pipeline)'
# For the optional VM worker use http://ollama:11434; loopback is for host execution.
AUTODOCS_OLLAMA_URL=http://127.0.0.1:11434
AUTODOCS_EMBEDDING_THREADS=2
AUTODOCS_DB_CONNECT_TIMEOUT_SECONDS=10

# Development Compose only; these are public demo placeholders, never production secrets.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=autodocs
POSTGRES_USER=autodocs
POSTGRES_PASSWORD=autodocs-local-change-me
DATABASE_URL=postgresql+psycopg://autodocs:autodocs-local-change-me@postgres:5432/autodocs
FASTEMBED_CACHE_PATH=/models/fastembed
# Apply migrations only when explicitly requested during devcontainer setup.
AUTO_APPLY_MIGRATIONS=false

# Keep tracing disabled for offline examples and local validation.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
# Optional disposable PostgreSQL test database, never a reusable application database.
# AUTODOCS_INTEGRATION_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/disposable_test_db
