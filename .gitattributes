# File: .gitattributes
# Purpose: Normalize text line endings while preserving byte-hashed publication inputs.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Keep byte-hashed publication inputs stable across Windows checkouts.
/docs/generated/**/*.md text eol=lf
/docs/generated/**/*.json text eol=lf
/website/publication.json text eol=lf
