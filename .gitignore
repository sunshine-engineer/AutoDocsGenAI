# File: .gitignore
# Purpose: Exclude local settings, caches, secrets and generated runtime artifacts.
# Maintainer: sunshine-engineer
# Modified: 2026-10-23
# Python environments and caches
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/

# Local configuration and editor state
.env
.vscode/
.idea/

# Runtime output
logs/
*.log
tmp/
data/raw/
data/cleaned/
data/chunks/
data/embeddings/
data/vectorstore/
data/generated_docs/
data/catalogs/
data/source_snapshots/
data/pilot_runs/

# Local documentation website build
.site-work/

# Disposable deployment validation state / secrets
.deploy-test/
deploy/.env*
deploy/runtime.env
